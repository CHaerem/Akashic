# Akashic Environment Variables
# Copy this to .env.local and fill in your values

# MapKit JS (the journey map). MAP-05 deleted Mapbox; the landing globe needs NO token at all,
# so with this unset the app runs and only the journey map degrades to an error card.
# Mint a localhost token for the dev loop (needs the .p8 at ~/.keys/AuthKey_<keyId>.p8):
#   VITE_MAPKIT_TOKEN=$(node scripts/mapkit/devToken.mjs)
# It is public by design — it ships in the client bundle, protected by its `origin` claim, not by
# secrecy. Production mints its own per deploy in .github/workflows/deploy-pages.yml.
VITE_MAPKIT_TOKEN=mint-with-scripts/mapkit/devToken.mjs

# CloudKit (auth + database) - the only backend.
# Container is iCloud.no.akashic; CloudKit JS is loaded from Apple's CDN.
# VITE_CLOUDKIT_ENV=development            # 'development' (default) | 'production'
# VITE_CLOUDKIT_API_TOKEN=your-cloudkit-api-token

# Media Worker (optional - defaults to production)
# VITE_MEDIA_URL=https://akashic-media.chris-haerem.workers.dev

# E2E Testing (optional - set to 'true' to disable auth for automated tests)
# VITE_E2E_TEST_MODE=true
