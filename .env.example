# Akashic Environment Variables
# Copy this to .env.local and fill in your values

# Mapbox (for 3D globe)
VITE_MAPBOX_TOKEN=your-mapbox-token

# CloudKit (auth + database) - the only backend.
# Container is iCloud.no.akashic; CloudKit JS is loaded from Apple's CDN.
# VITE_CLOUDKIT_ENV=development            # 'development' (default) | 'production'
# VITE_CLOUDKIT_API_TOKEN=your-cloudkit-api-token

# Media Worker (optional - defaults to production)
# VITE_MEDIA_URL=https://akashic-media.chris-haerem.workers.dev

# E2E Testing (optional - set to 'true' to disable auth for automated tests)
# VITE_E2E_TEST_MODE=true
