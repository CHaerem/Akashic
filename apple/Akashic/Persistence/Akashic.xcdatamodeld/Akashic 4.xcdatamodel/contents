    <!-- Side table holding each synced record's encoded CloudKit system fields (recordID, zone,
         server change tag). Written on remote-apply and on a successful send; read by
         `makeRecord` to rehydrate the last-known server record so a first edit of an existing row
         is sent as an UPDATE, not an INSERT that CloudKit rejects with server error 14. A side
         table (one place to look up / clean up, indexed by recordName) beats per-entity
         attributes: no churn on the four domain entities, still a lightweight migration (a brand
         new entity has no existing rows to transform). See `PersistenceController+Sync`. -->
    <entity name="CDSyncRecordMeta" representedClassName="CDSyncRecordMeta" syncable="YES" codeGenerationType="class">
        <attribute name="recordName" optional="YES" attributeType="String"/>
        <attribute name="systemFields" optional="YES" attributeType="Binary"/>
        <fetchIndex name="byRecordName">
            <fetchIndexElement property="recordName" type="Binary" order="ascending"/>
        </fetchIndex>
        <uniquenessConstraints>
            <uniquenessConstraint>
                <constraint value="recordName"/>
            </uniquenessConstraint>
        </uniquenessConstraints>
    </entity>
