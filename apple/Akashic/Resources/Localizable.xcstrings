    "We added the photos that fit. Akashic Complete lifts the 100-photo cap so the rest can come too.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi la inn bildene det var plass til. Akashic Complete fjerner grensen på 100 bilder, så resten får plass også."
          }
        }
      }
    },
    "We couldn't read dates from these photos. They'll be added to the journey; you can build days later.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fikk ikke lest datoer fra disse bildene. De blir lagt til turen, og du kan bygge dager senere."
          }
        }
      }
