        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv hva som skjedde denne dagen"
          }
        }
      }
    },
    "You have Akashic Complete": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har Akashic Complete"
          }
        }
      }
    },
    "You've filled your free journey. Akashic Complete removes the limit — for your whole family.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har fylt opp gratisturen din. Akashic Complete fjerner grensen – for hele familien."
          }
        }
      }
    },
    "Your data lives in your iCloud": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dataene dine bor i din iCloud"
          }
        }
      }
    },
    "Your iCloud is full — new photos are waiting to upload": {
      "comment": "Settings › iCloud sync status row: the owner's iCloud account is out of space, so uploads are rejected until they free space or buy more.",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-en din er full – nye bilder venter på å lastes opp"
          }
        }
      }
    },
    "Your journeys": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Turene dine"
          }
        }
      }
    },
    "Your journeys are in iCloud": {
      "comment": "Journeys list heading, shown INSTEAD of the \"Start your first journey\" hero when the family's journeys exist in iCloud but their download is waiting for Wi-Fi.",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Turene dine ligger i iCloud"
          }
        }
      }
    },
    "Your journeys and photos live in your own iCloud. We run no servers and never see them.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Turene og bildene dine bor i din egen iCloud. Vi har ingen servere, og ser dem aldri."
          }
        }
      }
    },
    "Your journeys will live here": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Turene dine havner her"
          }
        }
      }
    },
    "Your name": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet ditt"
          }
        }
      }
    },
    "Your photo archive downloads on this device's first sync. Downloading over cellular can use a large amount of data — waiting for Wi-Fi is recommended.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildearkivet lastes ned ved første synkronisering på denne enheten. Nedlasting over mobildata kan bruke mye data – vi anbefaler å vente på Wi-Fi."
          }
        }
      }
    },
    "Your photos carry dates but no locations, so days were proposed without a route.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene dine har datoer, men ingen posisjon, så dagene ble foreslått uten rute."
          }
        }
      }
    },
    "Your treks, on a living globe": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Turene dine, på en levende globus"
          }
        }
      }
    },
    "Zones": {
      "shouldTranslate": false
    },
    "Zones created": {
      "shouldTranslate": false
    },
    "e.g. Kilimanjaro — Lemosho Route": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. Kilimanjaro – Lemosho-ruta"
          }
        }
      }
    },
    "from your GPX file": {
      "comment": "Caption under the dates row when the dates came from an imported GPX track.",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "fra GPX-fila di"
          }
        }
      }
    },
    "from your photos": {
      "comment": "Caption under the dates row when the dates came from photo capture dates.",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "fra bildene dine"
          }
        }
      }
    },
    "grouped into %lld days by capture date": {
      "comment": "New journey: appended to the staged-photo count when capture dates produced days.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "grouped into %lld day by capture date"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "grouped into %lld days by capture date"
                }
              }
            }
          }
        },
        "nb": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "gruppert i %lld dag etter opptaksdato"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "gruppert i %lld dager etter opptaksdato"
                }
              }
            }
          }
        }
      }
    },
    "iCloud is restricted on this device": {
      "comment": "Settings › iCloud sync status row: iCloud is blocked by a configuration profile or parental controls.",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud er begrenset på denne enheten"
          }
        }
      }
    },
    "iCloud is restricted on this device. Akashic still works locally; sharing and sync need iCloud enabled in Settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud er begrenset på denne enheten. Akashic fungerer fortsatt lokalt; deling og synkronisering krever at iCloud er slått på i Innstillinger."
          }
        }
      }
    },
    "iCloud sync": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synkronisering"
          }
        }
      }
    },
    "iCloud temporarily unavailable": {
      "comment": "Settings › iCloud sync status row: iCloud could not be reached right now; it is expected to recover on its own.",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud er midlertidig utilgjengelig"
          }
        }
      }
    },
    "just now": {
