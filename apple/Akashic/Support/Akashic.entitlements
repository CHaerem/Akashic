<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  CloudKit + Push entitlements for the NSPersistentCloudKitContainer sync layer.
	  Referenced ONLY by the `Release-CloudKit` build configuration (see project.yml),
	  so the default Debug / Release simulator builds compile with no team and no signing.
	  Container id matches Config.cloudKitContainerIdentifier.
	-->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.no.akashic</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
